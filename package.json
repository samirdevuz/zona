{
  "name": "zona",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZONA - LAN zone-control FPS in the browser",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @zona/client && npm run build -w @zona/server",
    "start": "node packages/server/dist/main.js",
    "check": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/client && tsc -p tests/e2e",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "e2e": "npm run build && playwright test -c tests/e2e/playwright.config.ts",
    "sim": "tsx packages/server/src/sim.ts",
    "assets:fetch": "node scripts/assets/fetch.mjs",
    "assets:build": "node scripts/assets/build.mjs",
    "assets:audio": "node scripts/assets/audio.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "7z-wasm": "^1.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "fflate": "^0.8.2",
    "meshoptimizer": "^0.25.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vite": "^7.3.8"
  }
}
